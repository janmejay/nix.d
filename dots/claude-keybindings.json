{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "tab": "chat:cycleMode",
        "ctrl+e": "chat:externalEditor",
        "ctrl+j": "chat:submit"
      }
    },
    {
      "context": "History",
      "bindings": {
        "ctrl+k": "history:previous",
        "ctrl+j": "history:next"
      }
    },
    {
      "context": "Confirm",
      "bindings": {
        "ctrl+k": "confirm:previous",
        "ctrl+j": "confirm:next"
      }
    }
  ]
}
